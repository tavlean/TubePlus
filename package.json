{
    "name": "tubeplus",
    "version": "1.5.2",
    "description": "Browser extension that cleans YouTube Mix and playlist watch URLs",
    "private": true,
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "dev": "node scripts/build.js dev",
        "dev:chrome": "node scripts/build.js dev chrome",
        "dev:firefox": "node scripts/build.js dev firefox",
        "build": "node scripts/build.js build",
        "build:chrome": "node scripts/build.js build chrome",
        "build:firefox": "node scripts/build.js build firefox",
        "test": "node --test test/*.test.js",
        "test:smoke": "node test/e2e/chrome-offline.js",
        "test:e2e": "node test/e2e/chromium.e2e.js && node test/e2e/firefox.e2e.js",
        "test:e2e:chromium": "node test/e2e/chromium.e2e.js",
        "test:e2e:firefox": "node test/e2e/firefox.e2e.js"
    },
    "keywords": [
        "chrome-extension",
        "firefox-extension",
        "browser-extension",
        "youtube"
    ],
    "license": "MIT",
    "devDependencies": {
        "geckodriver": "^6.1.0",
        "playwright": "^1.61.1",
        "selenium-webdriver": "^4.46.0"
    }
}
